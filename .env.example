# Backend (gambknd) base URL. The browser calls it directly with credentials (CORS is locked to this app's origin).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Set to 1 when the frontend and API are on unrelated domains, such as vercel.app and onrender.com.
# API calls then go through this site, and NEXT_PUBLIC_API_URL stays the real backend URL.
NEXT_PUBLIC_API_PROXY=
# Socket.IO server (same process as the API).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
